{
  "$schema": "../../schema/app.schema.json",
  "id": "edit",
  "name": "Edit Image",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Inpaint / Edit",
  "summary": "Describe a change and Qwen-Image-Edit applies it to your photo.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_qwen_image_edit.json",
    "comfyui": "0.42.0",
    "notes": "Qwen-Image-Edit 2509 fp8 with 4-step Lightning LoRA for fast instruction-based image editing."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "instruction",
      "type": "textarea",
      "label": "What should change?",
      "required": true,
      "default": "Make her hair long and straight reaching past her shoulders, sleek brunette hairstyle",
      "help": "Use English instructions (e.g. 'Make her hair long and straight') for best editing accuracy with Qwen-Image-Edit.",
      "bind": [
        {
          "node": "4",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4,
      "help": "4 steps is optimal for the Lightning LoRA",
      "bind": [
        {
          "node": "16",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Edited"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "split_files/diffusion_models/qwen_image_edit_2509_fp8_e4m3fn.safetensors",
      "dir": "diffusion_models",
      "gb": 20.43,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image_ComfyUI",
      "file": "split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "dir": "text_encoders",
      "gb": 9.38,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image_ComfyUI",
      "file": "split_files/vae/qwen_image_vae.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "lightx2v/Qwen-Image-Lightning",
      "file": "Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors",
      "dir": "loras",
      "gb": 0.85,
      "phase": "denoise",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Qwen-Image-Edit-2509 by Alibaba Qwen (Apache-2.0)",
    "Lightning LoRA by lightx2v",
    "Workflow: ComfyUI official template"
  ],
  "test": {
    "image": "test/portrait.png",
    "instruction": "make the background a beach"
  }
}
