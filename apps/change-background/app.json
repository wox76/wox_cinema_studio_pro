{
  "$schema": "../../schema/app.schema.json",
  "id": "change-background",
  "name": "Change Background",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Change Background · AI Environment",
  "summary": "Cambia completamente l'ambientazione alle spalle del soggetto adattando riflessi e luce ambientale.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/app-change-background",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Foto",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "target",
      "type": "textarea",
      "label": "Nuovo sfondo",
      "required": true,
      "default": "a minimalist sunlit rooftop terrace overlooking Tokyo at blue hour",
      "bind": [
        {
          "node": "4",
          "field": "prompt",
          "template": "Replace the entire background with {target}. Keep the main subject, pose, face, clothing and hair edges exact, matching rim light and reflections cleanly."
        },
        {
          "node": "14",
          "field": "prompt",
          "template": "Replace the entire background with {target}. Keep the main subject, pose, face, clothing and hair edges exact, matching rim light and reflections cleanly."
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Sfondo sostituito"
    }
  ],
