{
  "$schema": "../../schema/app.schema.json",
  "id": "style-reference",
  "name": "Style Reference",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Style transfer",
  "summary": "Paints anything you describe in the exact visual style of a reference image (Qwen-Image-Edit 2509 for crisp, clean artwork).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_krea2_turbo_int8_image_style_reference.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "style",
      "type": "image",
      "label": "Style reference",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "help": "Only its look is used: palette, medium, texture",
      "bind": [
        {
          "node": "69",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What to paint",
      "required": true,
      "default": "a lighthouse on a cliff during a storm, waves crashing",
      "bind": [
        {
          "node": "30:19",
          "field": "value"
        }
      ]
    },
    {
      "id": "style_strength",
      "type": "slider",
      "label": "Style strength",
      "min": 0.3,
      "max": 1.2,
      "step": 0.05,
      "default": 0.75,
      "help": "How strongly to copy the reference art style, coloring, and linework (0.7–0.85 is the sweet spot).",
      "bind": [
        {
          "node": "ipa_apply",
          "field": "weight"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 6,
      "max": 16,
      "step": 1,
      "default": 8,
      "help": "8–10 steps is optimal for DreamShaper XL Turbo.",
      "bind": [
        {
          "node": "sampler",
          "field": "steps"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "1:1 (Square)",
      "options": [
        {
          "value": "1:1 (Square)",
          "label": "1:1 (Square)"
        },
        {
          "value": "2:3 (Portrait Photo)",
          "label": "2:3 (Portrait Photo)"
        },
        {
          "value": "3:2 (Photo)",
          "label": "3:2 (Photo)"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4 (Portrait Standard)"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3 (Standard)"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16 (Portrait Widescreen)"
        },
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9 (Widescreen)"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9 (Ultrawide)"
        }
      ],
      "bind": [
        {
          "node": "71",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Megapixels",
      "min": 0.5,
      "max": 2.0,
      "step": 0.25,
      "default": 1.0,
      "bind": [
        {
          "node": "71",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "sampler",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "29",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "stabilityai/stable-diffusion-xl-base-1.0",
      "file": "checkpoints/sd_xl_base_1.0.safetensors",
      "dir": "checkpoints",
      "gb": 6.94,
      "phase": "denoise",
      "license": "CreativeML Open RAIL++-M"
    },
    {
      "repo": "h94/IP-Adapter",
      "file": "ipadapter/ip-adapter-plus_sdxl_vit-h.safetensors",
      "dir": "ipadapter",
      "gb": 0.85,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "h94/IP-Adapter",
      "file": "clip_vision/CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "dir": "clip_vision",
      "gb": 2.53,
      "phase": "encode",
      "license": "MIT"
    }
  ],
  "credits": [
    "Krea 2 Turbo by Krea (Krea 2 Community License)",
    "Style reference LoRA by ostris",
    "Workflow: ComfyUI official template"
  ],
  "test": {
    "style": "test/portrait.png"
  }
}
