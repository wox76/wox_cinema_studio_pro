{
  "$schema": "../../schema/app.schema.json",
  "id": "draw-to-video",
  "name": "Draw to Video · Wan-Move",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "Motion Paths Draw-to-Video",
  "summary": "Disegna direttamente sull'immagine le traiettorie di camera e oggetti: Wan-Move (6 step turbo) le anima con precisione.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/draw-to-video-wan-move.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Immagine di partenza",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "first_frame",
          "field": "image"
        }
      ]
    },
    {
      "id": "tracks",
      "type": "textarea",
      "label": "Traiettorie Disegnate (JSON)",
      "required": true,
      "default": "{\"aspect\":[832,480],\"paths\":[[[0.3,0.6],[0.6,0.35]]]}",
      "help": "Disegna una o più frecce sulla tela interattiva sopra l'immagine.",
      "bind": []
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Azione della scena",
      "required": true,
      "default": "Smooth natural cinematic motion following the drawn trajectories, crisp details",
      "bind": [
        {
          "node": "prompt",
          "field": "value",
          "template": "{prompt}. Follow the specified motion trajectory smoothly."
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Formato & Risoluzione",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        }
      ],
      "bind": [
        {
          "node": "res",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "duration",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "bind": [
        {
          "node": "steps",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "seed",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "Wan-Move (ByteDance / Kijai)",
    "LightX2V Distill LoRA",
    "Workflow from Fuobe"
  ]
}
