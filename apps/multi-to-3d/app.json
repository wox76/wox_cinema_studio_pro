{
  "$schema": "../../schema/app.schema.json",
  "id": "multi-to-3d",
  "name": "Multi-View to 3D · Pixal3D",
  "section": "3d",
  "pack": "3d-studio",
  "status": "ready",
  "modes": [
    "pixal3d",
    "multi-to-3d",
    "text-to-3d",
    "object-to-3d",
    "triposplat-3d"
  ],
  "mode_label": "Multi-Vista",
  "higgsfield_feature": "Image to 3D · Multi-View (2–4 Sides)",
  "summary": "Ricostruisce oggetti 3D PBR (.GLB) ad altissima precisione partendo da 2 a 4 viste (Fronte, Sinistra, Retro, Destra) + Turntable.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/image-to-3d-trellis2-multiview.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "front",
      "type": "image",
      "label": "Vista Frontale (Obbligatoria)",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "360",
          "field": "image"
        }
      ]
    },
    {
      "id": "left",
      "type": "image",
      "label": "Lato Sinistro (Opzionale)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "361",
          "field": "image"
        }
      ]
    },
    {
      "id": "back",
      "type": "image",
      "label": "Retro (Opzionale)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "362",
          "field": "image"
        }
      ]
    },
    {
      "id": "right",
      "type": "image",
      "label": "Lato Destro (Opzionale)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "363",
          "field": "image"
        }
      ]
    },
    {
      "id": "texture_size",
      "type": "select",
      "label": "Risoluzione Texture PBR",
      "default": 2048,
      "options": [
        {
          "value": 1024,
          "label": "1024×1024 (Veloce)"
        },
        {
          "value": 2048,
          "label": "2048×2048 (HD Consigliato)"
        },
        {
          "value": 4096,
          "label": "4096×4096 (4K Ultra)"
        }
      ],
      "bind": [
        {
          "node": "288",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "3",
          "field": "seed"
        },
        {
          "node": "12",
          "field": "seed"
        },
        {
          "node": "18",
          "field": "seed"
        },
        {
          "node": "23",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "372",
      "type": "3d",
      "label": "Modello 3D Multi-View .GLB"
    },
    {
      "node": "702",
      "type": "video",
      "label": "Turntable 360°"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Pixal3D",
      "file": "diffusion_models/pixal3d_multiview_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.58,
      "phase": "denoise"
    },
    {
      "repo": "Comfy-Org/Pixal3D",
      "file": "clip_vision/dino_v3_L_naf_fp32.safetensors",
      "dir": "clip_vision",
      "gb": 1.22,
      "phase": "encode"
    },
    {
      "repo": "Comfy-Org/Pixal3D",
      "file": "vae/trellis_2_shape_vae_bf16.safetensors",
      "dir": "vae",
      "gb": 1.1,
      "phase": "decode"
    },
    {
      "repo": "Comfy-Org/Pixal3D",
      "file": "vae/trellis_2_texture_vae_bf16.safetensors",
      "dir": "vae",
      "gb": 0.95,
      "phase": "decode"
    },
    {
      "repo": "Comfy-Org/MoGe",
      "file": "geometry_estimation/moge_2_vitl_normal_fp16.safetensors",
      "dir": "geometry_estimation",
      "gb": 0.66,
      "phase": "aux"
    },
    {
      "repo": "Comfy-Org/BiRefNet",
      "file": "background_removal/birefnet.safetensors",
      "dir": "background_removal",
      "gb": 0.44,
      "phase": "aux"
    }
  ],
  "credits": [
    "Pixal3D Multi-View & TRELLIS.2",
    "MoGe-2 FOV Estimator",
    "Workflow from Fuobe"
  ]
}
