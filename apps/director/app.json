{
  "$schema": "../../schema/app.schema.json",
  "id": "director",
  "name": "AI Director",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "AI Director / Multi-Reference Previs",
  "modes": [
    "cinema-studio",
    "cinema-video",
    "director"
  ],
  "mode_label": "AI Director",
  "summary": "Direct any animation with 3D previs, assets, characters and styles using generic @ref1, @ref2, @ref3, @ref4, @ref5 tags.",
  "workflow": "workflow.api.json",
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Scene",
      "required": true,
      "default": "Prendi come riferimento il video 3D in @ref1, per il treno utilizza @ref2, riempilo di persone con lo stile di @ref3. Alla fine dell'animazione il personaggio in @ref4 deve salutare in camera",
      "help": "Use generic tags @ref1, @ref2, @ref3, @ref4, @ref5 to explain and reference your attached media files.",
      "bind": [
        {
          "node": "still:18:17",
          "field": "value",
          "template": "A cinematic film still{genre}{era}: {prompt}. The look: {camera}; {lens}; {focal}; {aperture}. Lighting: {lighting}. Color: {palette}. High dynamic range, ultra-detailed"
        },
        {
          "node": "398:376",
          "field": "value",
          "template": "{moves}{prompt}.{tempo} The look of a film{genre}{era}: {camera}; {lens}. Lighting: {lighting}. Color: {palette}."
        }
      ]
    },
    {
      "id": "first_frame",
      "type": "image",
      "label": "First frame",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "help": "Optional initial frame. If uploaded, the video animates starting directly from this image; otherwise it is generated automatically.",
      "bind": [
        {
          "node": "first_frame",
          "field": "image"
        }
      ]
    },
    {
      "id": "ref1",
      "type": "video",
      "label": "Reference 1 (@ref1)",
      "required": false,
      "limits": {
        "max_mb": 200,
        "seconds": [
          2,
          15
        ]
      },
      "help": "Video guide, motion or 3D previs clip (@ref1)",
      "bind": [
        {
          "node": "1",
          "field": "file"
        }
      ]
    },
    {
      "id": "ref2",
      "type": "image",
      "label": "Reference 2 (@ref2)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "help": "Visual reference image (@ref2)",
      "bind": [
        {
          "node": "still:18:11",
          "field": "image"
        }
      ]
    },
    {
      "id": "ref3",
      "type": "image",
      "label": "Reference 3 (@ref3)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "help": "Visual reference image (@ref3)",
      "bind": [
        {
          "node": "still:18:12",
          "field": "image"
        }
      ]
    },
    {
      "id": "ref4",
      "type": "image",
      "label": "Reference 4 (@ref4)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "help": "Visual reference image (@ref4)",
      "bind": [
        {
          "node": "still:18:13",
          "field": "image"
        }
      ]
    },
    {
      "id": "ref5",
      "type": "image",
      "label": "Reference 5 (@ref5)",
      "required": false,
      "limits": {
        "max_mb": 20
      },
      "help": "Visual reference image (@ref5)",
      "bind": [
        {
          "node": "still:18:14",
          "field": "image"
        }
      ]
    },
    {
      "id": "moves",
      "type": "select",
      "label": "Camera move",
      "default": [
        "slowly dollies in toward the subject"
      ],
      "multiple": {
        "max": 3,
        "join": ", then ",
        "prefix": "The camera ",
        "suffix": ". ",
        "ordered": true
      },
      "help": "Up to 3, in the order picked. One move holds best: with two, the lab found the model does not always keep the order.",
      "options": [
        {
          "value": "stays locked off on a tripod, perfectly still",
          "label": "Static shot"
        },
        {
          "value": "slowly dollies in toward the subject",
          "label": "Dolly in"
        },
        {
          "value": "slowly dollies back away from the subject",
          "label": "Dolly out"
        },
        {
          "value": "zooms in slowly",
          "label": "Slow zoom in"
        },
        {
          "value": "zooms out slowly",
          "label": "Slow zoom out"
        },
        {
          "value": "crash-zooms in fast on the subject",
          "label": "Crash zoom"
        },
        {
          "value": "dolly-zooms, moving in while zooming out so the background stretches behind the subject",
          "label": "Dolly zoom"
        },
        {
          "value": "pans left",
          "label": "Pan left"
        },
        {
          "value": "pans right",
          "label": "Pan right"
        },
        {
          "value": "whip-pans fast to the side with motion blur",
          "label": "Whip pan"
        },
        {
          "value": "tilts up",
          "label": "Tilt up"
        },
        {
          "value": "tilts down",
          "label": "Tilt down"
        },
        {
          "value": "trucks left, sliding sideways",
          "label": "Truck left"
        },
        {
          "value": "trucks right, sliding sideways",
          "label": "Truck right"
        },
        {
          "value": "glides left on a slider, close to the subject",
          "label": "Slider left"
        },
        {
          "value": "glides right on a slider, close to the subject",
          "label": "Slider right"
        },
        {
          "value": "arcs left around the subject",
          "label": "Arc left"
        },
        {
          "value": "arcs right around the subject",
          "label": "Arc right"
        },
        {
          "value": "rises straight up, staying level",
          "label": "Pedestal up"
        },
        {
          "value": "lowers straight down, staying level",
          "label": "Pedestal down"
        },
        {
          "value": "cranes up and back, rising over the scene",
          "label": "Crane up"
        },
        {
          "value": "cranes down from above toward the subject",
          "label": "Crane down"
        },
        {
          "value": "tracks behind the subject as they move",
          "label": "Tracking"
        },
        {
          "value": "tracks alongside the subject, moving sideways with them",
          "label": "Side tracking"
        },
        {
          "value": "is handheld, with a slight natural shake",
          "label": "Handheld"
        },
        {
          "value": "shows the character's point of view, moving as their eyes would",
          "label": "POV"
        },
        {
          "value": "is rigged to the actor's body, so their face stays fixed in the frame while the world sways behind them",
          "label": "Snorricam"
        },
        {
          "value": "sweeps around the subject in one fast, precise robotic-arm move",
          "label": "Robot arm"
        },
        {
          "value": "racks focus from the foreground to the background",
          "label": "Rack focus"
        },
        {
          "value": "orbits the scene from above like a drone",
          "label": "Drone orbit"
        },
        {
          "value": "pulls back and up into a high aerial view",
          "label": "Aerial pullback"
        },
        {
          "value": "flies over the scene from high above like a helicopter",
          "label": "Helicopter shot"
        },
        {
          "value": "circles around a frozen moment in slow motion, bullet-time style",
          "label": "Bullet time"
        }
      ],
      "bind": []
    },
    {
      "id": "tempo",
      "type": "select",
      "label": "Tempo",
      "default": "",
      "help": "The editing rhythm. Single shot keeps one take; Dynamic and Chaotic ask for cuts.",
      "options": [
        {
          "value": "",
          "label": "Auto"
        },
        {
          "value": " Calm pacing: slow, unhurried movement in one long take.",
          "label": "Calm"
        },
        {
          "value": " Dynamic pacing: brisk movement and a quick cut to a closer angle halfway through.",
          "label": "Dynamic"
        },
        {
          "value": " Chaotic pacing: frantic energy, fast action and several rapid cuts between angles.",
          "label": "Chaotic"
        },
        {
          "value": " One continuous shot, no cuts.",
          "label": "Single shot"
        }
      ],
      "bind": []
