{
  "$schema": "../../schema/app.schema.json",
  "id": "scene-3d-moge",
  "name": "Scene 3D Mesh · MoGe-2",
  "section": "3d",
  "pack": "upscale",
  "status": "ready",
  "higgsfield_feature": "3D Scene Reconstruction",
  "summary": "Trasforma l'intera inquadratura in una scena 3D texturizzata (.GLB) + mappa di profondità (4GB VRAM, pronto subito!).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/scene-mesh-moge.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Immagine della scena",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "1",
          "field": "image"
        }
      ]
    },
    {
      "id": "resolution_level",
      "type": "slider",
      "label": "Dettaglio Geometria",
      "min": 4,
      "max": 9,
      "step": 1,
      "default": 9,
      "bind": [
        {
          "node": "7",
          "field": "resolution_level"
        }
      ]
    },
    {
      "id": "decimation",
      "type": "slider",
      "label": "Decimazione Mesh",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1,
      "help": "1 = massima risoluzione; 4 = leggero e veloce",
      "bind": [
        {
          "node": "8",
          "field": "decimation"
        }
      ]
    },
    {
      "id": "fov_x",
      "type": "slider",
      "label": "FOV Orizzontale (0 = Auto)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "bind": [
        {
          "node": "7",
          "field": "fov_x_degrees"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "3d",
      "label": "Scena 3D .GLB"
    },
    {
      "node": "11",
      "type": "image",
      "label": "Depth Map"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MoGe",
      "file": "geometry_estimation/moge_2_vitl_normal_fp16.safetensors",
      "dir": "geometry_estimation",
      "gb": 0.66,
      "phase": "all",
      "license": "MIT"
    }
  ],
  "credits": [
    "MoGe-2 (Microsoft)",
    "Workflow from Fuobe"
  ]
}
