{
  "$schema": "../../schema/app.schema.json",
  "id": "fly-path",
  "name": "Fly Path 3D · Uni3C",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "3D Camera Path Flight",
  "summary": "Vola con la camera lungo una traiettoria 3D (Orbit 360°, Arc 90°, Figure-8, Tilted Ring, Dolly, Truck) guidata da Uni3C.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/wan21-i2v-uni3c-path.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Immagine di partenza",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "guide_image",
          "field": "image"
        }
      ]
    },
    {
      "id": "video",
      "type": "video",
      "label": "Video Guida Traiettoria 3D",
      "required": true,
      "help": "Generato automaticamente dal compositore 3D sopra oppure carica un render/video guida.",
      "bind": [
        {
          "node": "ref_video",
          "field": "file"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Scena & Movimento",
      "required": true,
      "default": "The scene stays alive naturally while the camera glides smoothly along the 3D flight path",
      "bind": [
        {
          "node": "prompt",
          "field": "value",
          "template": "Follow the 3D camera flight path of <Video 1> starting from the opening scene. {prompt}"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Formato & Risoluzione",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        }
      ],
      "bind": [
        {
          "node": "res",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "bind": [
        {
          "node": "steps",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "seed",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "duration",
          "field": "value"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "Wan 2.1 I2V + Uni3C ControlNet",
    "Camera Path Math from Fuobe"
  ]
}
