{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "clip.mp4"
    },
    "_meta": {
      "title": "Target Video"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.0,
      "duration": 10.0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Slice 10s"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Frames & Audio"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "face.png"
    },
    "_meta": {
      "title": "Source Face"
    }
  },
  "5": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "input_image": [
        "3",
        0
      ],
      "source_image": [
        "4",
        0
      ],
      "swap_model": "inswapper_128.onnx",
      "facedetection": "retinaface_resnet50",
      "face_restore_model": "GFPGANv1.4.pth",
      "face_restore_visibility": 1.0,
      "codeformer_weight": 0.5,
      "detect_gender_input": "no",
      "detect_gender_source": "no",
      "input_faces_index": "0",
      "source_faces_index": "0",
      "console_log_level": 1
    },
    "_meta": {
      "title": "ReActor Video Face Swap"
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "audio": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Assemble Video"
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "wox-cinema-studio-pro/video-face-swap",
      "format": "auto",
      "format.codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  }
}
