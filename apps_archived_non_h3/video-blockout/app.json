{
  "$schema": "../../schema/app.schema.json",
  "id": "video-blockout",
  "name": "3D Blockout to Video",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "Cinema Studio · 3D Blockout Pre-vis",
  "summary": "Converte un pre-vis / wireframe / blockout 3D di camera e un frame guida in ripresa cinematografica fotorealistica (Wan 2.2 Fun VACE).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/video-blockout-wan22-fun-vace.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "video",
      "type": "video",
      "label": "Video Blockout / Pre-vis 3D",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          1,
          15
        ]
      },
      "bind": [
        {
          "node": "ref_video",
          "field": "file"
        }
      ]
    },
    {
      "id": "first_frame",
      "type": "image",
      "label": "Primo Fotogramma Renderizzato",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "guide_image",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Scena & Azione Finale",
      "required": true,
      "default": "Photorealistic cinema shot following the exact 3D camera blocking and character staging, film grain, dramatic lighting",
      "bind": [
        {
          "node": "prompt",
          "field": "value",
          "template": "Follow the layout and motion of <Video 1> starting from the visual appearance of the opening frame. {prompt}"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Formato & Risoluzione",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        }
      ],
      "bind": [
        {
          "node": "res",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "duration",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "seed",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "bind": [
        {
          "node": "steps",
          "field": "value"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "Wan 2.2 Fun VACE 14B"
  ]
}
