{
  "$schema": "../../schema/app.schema.json",
  "id": "qwen-layered",
  "name": "Qwen RGBA Layers",
  "section": "image",
  "pack": "image-qwen-layered",
  "status": "ready",
  "higgsfield_feature": "Split Image into Layers",
  "summary": "Scompone qualsiasi immagine in 2–8 livelli RGBA trasparenti separati (sfondo, soggetti, testo, luce) con Qwen-Image-Layered.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/layers-qwen-image-layered.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Immagine da scomporre",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "74",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Descrizione contenuto (opzionale)",
      "default": "",
      "help": "Aiuta il modello a separare gli elementi desiderati.",
      "bind": [
        {
          "node": "116",
          "field": "value"
        }
      ]
    },
    {
      "id": "num_layers",
      "type": "slider",
      "label": "Numero Livelli RGBA",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "bind": [
        {
          "node": "83:118",
          "field": "layers"
        }
      ]
    },
    {
      "id": "max_size",
      "type": "select",
      "label": "Risoluzione Elaborazione",
      "default": 640,
      "options": [
        {
          "value": 640,
          "label": "640 px (Standard · Veloce)"
        },
        {
          "value": 1024,
          "label": "1024 px (Alta Risoluzione)"
        }
      ],
      "bind": [
        {
          "node": "82",
          "field": "largest_size"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 20,
      "bind": [
        {
          "node": "83:3",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "83:3",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "60",
      "type": "image",
      "label": "Livelli RGBA"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image-Layered_ComfyUI",
      "file": "split_files/diffusion_models/qwen_image_layered_fp8mixed.safetensors",
      "dir": "diffusion_models",
      "gb": 20.53,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image_ComfyUI",
      "file": "split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "dir": "text_encoders",
      "gb": 9.38,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image-Layered_ComfyUI",
      "file": "split_files/vae/qwen_image_layered_vae.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Qwen-Image-Layered (Alibaba)",
    "Workflow from Fuobe"
  ],
  "modes": [
    "qwen-layered",
    "layers-control"
  ],
  "mode_label": "Auto RGBA"
}
