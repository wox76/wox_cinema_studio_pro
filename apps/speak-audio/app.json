{
  "$schema": "../../schema/app.schema.json",
  "id": "speak-audio",
  "name": "Speak - Input mp3",
  "section": "video",
  "modes": [
    "speak",
    "speak-audio",
    "speak-video-audio"
  ],
  "mode_label": "Input mp3",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "Speak",
  "summary": "Carica un ritratto e un file audio (.mp3 / .wav) per un Lip-Sync preciso fonema-per-fonema con LatentSync 1.6.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "ComfyUI-LatentSyncWrapper (LatentSync 1.6)",
    "comfyui": "0.42.0",
    "notes": "Lip-sync fonema-per-fonema su ritratto + MP3/WAV con LatentSync 1.6 (i pesi vengono scaricati automaticamente al primo avvio)."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Portrait",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "1",
          "field": "image"
        }
      ]
    },
    {
      "id": "audio",
      "type": "audio",
      "label": "File Audio (.mp3 / .wav)",
      "required": true,
      "help": "Carica la traccia vocale o musicale: LatentSync anima la bocca solo quando c'è voce.",
      "limits": {
        "max_mb": 50,
        "seconds": [
          1,
          120
        ]
      },
      "bind": [
        {
          "node": "2",
          "field": "audio"
        }
      ]
    },
    {
      "id": "start_sec",
      "type": "slider",
      "label": "Inizio audio (secondi)",
      "min": 0,
      "max": 180,
      "step": 1,
      "default": 0,
      "help": "Salta eventuale intro musicale e parti direttamente dalla voce.",
      "bind": [
        {
          "node": "2t",
          "field": "start_index"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Durata clip (secondi)",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 10,
      "help": "Limita la durata per restare dentro la VRAM (24 GB: consigliato 10-20s).",
      "bind": [
        {
          "node": "2t",
          "field": "duration"
        }
      ]
    },
    {
      "id": "lips_expression",
      "type": "slider",
      "label": "Espressività Labbra",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.5,
      "help": "1.5 = naturale, valori più alti = movimento labbra più marcato.",
      "bind": [
        {
          "node": "4",
          "field": "lips_expression"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Passi (Steps)",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20,
      "bind": [
        {
          "node": "4",
          "field": "inference_steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": 1247,
      "bind": [
        {
          "node": "4",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "6",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [],
  "credits": [
    "ByteDance LatentSync 1.6 (ComfyUI-LatentSyncWrapper)"
  ]
}
