# Modal profile this repo uses (`modal profile list`). Deploys, downloads, the lab and setup_token.py
# stop when another profile is active.
WOX_MODAL_PROFILE=
# Gateway in front of comfy-api-proxy (the Modal URL printed by `modal deploy infra/modal_app.py`,
# or http://127.0.0.1:8000 when running the gateway locally).
COMFY_BASE_URL=https://YOUR-WORKSPACE--wox-serve.modal.run
# Written by `python tools/setup_token.py`, which stores the same value in the Modal secret "wox".
WOX_TOKEN=
# Passcode of the hosted demo (infra/web_app.py), written by `python tools/setup_demo.py`; only --link reads it here.
WOX_DEMO_PASSCODE=
# Let the web UI and the CLI run draft apps too (their workflows have not been run on a GPU yet).
# WOX_DRAFTS=1
