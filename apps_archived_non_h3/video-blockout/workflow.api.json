{
  "75": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "create_video",
        0
      ],
      "filename_prefix": "wox-cinema-studio-pro/video-blockout",
      "format": "auto",
      "format.codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  },
  "prompt": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "A cinematic video shot"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "res": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "16:9 (Widescreen)",
      "megapixels": 0.9,
      "multiple": 32
    },
    "_meta": {
      "title": "Resolution Selector"
    }
  },
  "duration": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 5
    },
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "length_expr": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "values.a": [
        "duration",
        0
      ],
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
    },
    "_meta": {
      "title": "Frame Count (17k+5)"
    }
  },
  "steps": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 20
    },
    "_meta": {
      "title": "Steps"
    }
  },
  "seed": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1
    },
    "_meta": {
      "title": "RandomNoise"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load MiniMax H3 Diffusion Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {
      "title": "Load MiniMax H3 CLIP"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    },
    "_meta": {
      "title": "Load Video VAE"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "_meta": {
      "title": "Load Audio VAE"
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "_meta": {
      "title": "KSamplerSelect"
    }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "steps": [
        "steps",
        0
      ],
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": {
      "title": "BasicScheduler"
    }
  },
  "ref_video": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "test.mp4"
    },
    "_meta": {
      "title": "Reference Video (<Video 1>)"
    }
  },
  "ref_video_comp": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "ref_video",
        0
      ]
    },
    "_meta": {
      "title": "Extract Video Components"
    }
  },
  "cond": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "audio_vae": [
        "audio_vae",
        0
      ],
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "length": [
        "length_expr",
        1
      ],
      "prompt": [
        "prompt",
        0
      ],
      "ref_image_size": "match",
      "ref_videos.ref_video_0": [
        "ref_video_comp",
        0
      ],
      "ref_video_audios.ref_video_audio_0": [
        "ref_video_comp",
        1
      ]
    },
    "_meta": {
      "title": "MiniMax H3 Reference to Video"
    }
  },
  "guide_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "asset.png"
    },
    "_meta": {
      "title": "Guide Frame"
    }
  },
  "guide_image_scale": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "upscale_method": "lanczos",
      "megapixels": 0.9,
      "resolution_steps": 32,
      "image": [
        "guide_image",
        0
      ]
    },
    "_meta": {
      "title": "Scale Guide Frame"
    }
  },
  "guide": {
    "class_type": "MiniMaxH3AddGuide",
    "inputs": {
      "positive": [
        "cond",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "latent": [
        "cond",
        1
      ],
      "image": [
        "guide_image_scale",
        0
      ],
      "frame_idx": 0
    },
    "_meta": {
      "title": "MiniMax H3 Add Guide"
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "conditioning": [
        "guide",
        0
      ]
    },
    "_meta": {
      "title": "Basic Guider"
    }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "seed",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler_select",
        0
      ],
      "sigmas": [
        "scheduler",
        0
      ],
      "latent_image": [
        "cond",
        1
      ]
    },
    "_meta": {
      "title": "SamplerCustomAdvanced"
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "vae_decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "audio_vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode Audio"
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "vae_decode",
        0
      ],
      "audio": [
        "vae_decode_audio",
        0
      ],
      "fps": 24,
      "bit_depth": 8
    },
    "_meta": {
      "title": "Create Video"
    }
  }
}
