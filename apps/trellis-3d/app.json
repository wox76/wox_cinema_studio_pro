          "value": "Native Sharp (Massimo Dettaglio Volto)"
        },
        {
          "node": "trellis",
          "field": "texture_size",
          "value": "4096 (4K Ultra PBR)"
        },
        {
          "node": "trellis",
          "field": "max_tokens",
          "value": "81920 (Massimo Dettaglio · 16GB Tight)"
        },
        {
          "node": "trellis",
          "field": "camera_fov",
          "value": 0.28
        },
        {
          "node": "trellis",
          "field": "steps",
          "value": 24
        },
        {
          "node": "trellis",
          "field": "guidance_strength",
          "value": 8.0
        },
        {
