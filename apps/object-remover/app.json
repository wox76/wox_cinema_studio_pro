      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Foto ripulita"
    }
  ],
