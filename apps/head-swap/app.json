{
  "$schema": "../../schema/app.schema.json",
  "id": "head-swap",
  "name": "Head Swap",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Head Swap · Full Hair & Identity",
  "summary": "Trasferisce l'intera testa (volto, capelli, attaccatura e orecchie) dalla seconda foto mantenendo corpo, abiti e luci.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/app-head-swap",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Foto Corpo/Scena (Picture 1)",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "head",
      "type": "image",
      "label": "Foto Testa/Capelli (Picture 2)",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "21",
          "field": "image"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Indicazioni extra (opzionale)",
      "default": "",
      "bind": [
        {
          "node": "4",
          "field": "prompt",
          "template": "Replace the whole head of the person in Picture 1, hair, hairline and ears included, with the head of the person in Picture 2. Keep Picture 1's body, pose, outfit, background and lighting identical, matching skin tone naturally. {details}"
        },
        {
          "node": "14",
          "field": "prompt",
          "template": "Replace the whole head of the person in Picture 1, hair, hairline and ears included, with the head of the person in Picture 2. Keep Picture 1's body, pose, outfit, background and lighting identical, matching skin tone naturally. {details}"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Risultato"
    }
  ],
