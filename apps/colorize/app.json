{
  "$schema": "../../schema/app.schema.json",
  "id": "colorize",
  "name": "Photo Colorize",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Colorize B&W Archive Photo",
  "summary": "Dà colore naturale e storicamente accurato alle foto in bianco e nero preservando grana e tratti originali.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/app-colorize",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Foto",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "target",
      "type": "textarea",
      "label": "Note colore (opzionale)",
      "required": true,
      "default": "natural skin tones, warm period-accurate wardrobe and authentic film tones",
      "bind": [
        {
          "node": "4",
          "field": "prompt",
          "template": "Colorize this black-and-white photograph realistically with {target}. Keep every detail, face identity, texture and composition completely identical."
        },
        {
          "node": "14",
          "field": "prompt",
          "template": "Colorize this black-and-white photograph realistically with {target}. Keep every detail, face identity, texture and composition completely identical."
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Foto colorizzata"
    }
  ],
