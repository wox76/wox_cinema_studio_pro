{
  "$schema": "../../schema/app.schema.json",
  "id": "video-swap",
  "name": "Video Object Swap",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "higgsfield_feature": "Genjutsu Swap · Object/Subject in Video",
  "summary": "Sostituisce un oggetto, veicolo o soggetto tracciato nel video con quello presente nella tua foto di riferimento (Wan VACE).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/video-swap-wan-vace.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "video",
      "type": "video",
      "label": "Clip Video",
      "required": true,
      "limits": {
        "max_mb": 200,
        "seconds": [
          1,
          15
        ]
      },
      "bind": [
        {
          "node": "ref_video",
          "field": "file"
        }
      ]
    },
    {
      "id": "reference",
      "type": "image",
      "label": "Foto Soggetto/Oggetto di Sostituzione",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "ref_image",
          "field": "image"
        }
      ]
    },
    {
      "id": "target",
      "type": "text",
      "label": "Cosa sostituire nel video (SAM 3.1)",
      "required": true,
      "default": "the car",
      "bind": []
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Descrizione della scena con il nuovo elemento",
      "required": true,
      "default": "The object from the reference image blends seamlessly into the video with matching motion and lighting",
      "bind": [
        {
          "node": "prompt",
          "field": "value",
          "template": "In <Video 1>, replace {target} with the subject from <Picture 1>, preserving motion, lighting, and background. {prompt}"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Risoluzione target",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        }
      ],
      "bind": [
        {
          "node": "res",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "duration",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "seed",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "bind": [
        {
          "node": "steps",
          "field": "value"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "Wan 2.1 VACE 14B + SAM 3.1 Multiplex"
  ]
}
