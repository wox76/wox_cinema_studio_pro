{
  "$schema": "../../schema/app.schema.json",
  "id": "fashion-factory",
  "name": "Fashion Factory",
  "section": "image",
  "summary": "A fashion catalog photo of you wearing a garment from a second photo.",
  "higgsfield_feature": "Fashion Factory",
  "pack": "image-qwen-edit",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "qwen_image_edit_2509.json",
    "comfyui": "0.42.0",
    "notes": "Fashion Factory powered by Qwen Image Edit: keeps your face and body identical from Picture 1 and renders the exact garment, cut, color and pattern from Picture 2."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Your photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "image2",
      "type": "image",
      "label": "Garment photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "12",
          "field": "image"
        }
      ]
    },
    {
      "id": "scene",
      "type": "select",
      "label": "Scene",
      "default": "in a white studio cyclorama",
      "options": [
        {
          "value": "in a white studio cyclorama",
          "label": "Studio cyclorama"
        },
        {
          "value": "on a city street at golden hour",
          "label": "City street, golden hour"
        },
        {
          "value": "in a minimalist loft",
          "label": "Minimalist loft"
        },
        {
          "value": "walking a runway under spotlights",
          "label": "Runway"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "4",
          "field": "prompt",
          "template": "A fashion catalog photo: the person from Picture 1 wearing the garment from Picture 2, full-length, {scene}. Keep the face identical and the garment cut, color and pattern exactly as in its photo. {details}"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 4,
      "bind": [
        {
          "node": "16",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "split_files/diffusion_models/qwen_image_edit_2509_fp8_e4m3fn.safetensors",
      "dir": "diffusion_models",
      "gb": 20.43,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "dir": "text_encoders",
      "gb": 7.0,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "split_files/vae/qwen_image_vae.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "loras/Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors",
      "dir": "loras",
      "gb": 0.85,
      "phase": "denoise",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Qwen-Image-Edit by Alibaba Cloud (Apache-2.0)"
  ],
  "test": {
    "image": "test/portrait.png",
    "image2": "test/second.png"
  }
}
