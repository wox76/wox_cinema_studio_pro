{
  "$schema": "../../schema/app.schema.json",
  "id": "match-lighting",
  "name": "Match Lighting",
  "section": "image",
  "pack": "image-qwen-edit",
  "status": "ready",
  "higgsfield_feature": "Match Lighting · Reference Light",
  "summary": "Trasferisce direzione, durezza e temperatura colore delle luci da una foto riferimento sul tuo scatto.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "fuobe/app-match-lighting",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Immagine da re-illuminare (Picture 1)",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "reference",
      "type": "image",
      "label": "Riferimento Luce (Picture 2)",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "21",
          "field": "image"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Note luce (opzionale)",
      "default": "",
      "bind": [
        {
          "node": "4",
          "field": "prompt",
          "template": "Relight Picture 1 so its lighting direction, softness, color temperature, reflections and shadows match Picture 2 exactly. Keep the subject, pose, clothes and scene of Picture 1 unchanged. {details}"
        },
        {
          "node": "14",
          "field": "prompt",
          "template": "Relight Picture 1 so its lighting direction, softness, color temperature, reflections and shadows match Picture 2 exactly. Keep the subject, pose, clothes and scene of Picture 1 unchanged. {details}"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "16",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Luce abbinata"
    }
  ],
